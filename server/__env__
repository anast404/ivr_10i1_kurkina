# Основные настройки сервера
PORT=3000
NODE_ENV=development

# База данных MongoDB
# 'db' — это имя сервиса из docker-compose.yml
MONGO_URI=mongodb://db:27017/auth_db

# Секреты для JWT (придумайте сложные строки)
JWT_ACCESS_SECRET=your_super_secret_access_key_123
JWT_REFRESH_SECRET=your_super_secret_refresh_key_456
JWT_EXPIRES_IN=15m

# Настройки почты (Nodemailer)
# Если используете Gmail: 
# 1. Включите 2FA 
# 2. Создайте "Пароль приложения" (App Password)
SMTP_HOST=://gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_specific_password

# Ссылки для писем
CLIENT_URL=http://localhost:3000
API_URL=http://localhost:3000/api
