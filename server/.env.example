# Скопируйте в .env и заполните. Файл .env не коммитить.
PORT=5000
MONGO_URI=mongodb://localhost:27017/happyhome
JWT_SECRET=change_me_long_random_string
EMAIL_USER=your_email@gmail.com
# Gmail "пароль приложения" (App Password)
EMAIL_PASS=your_app_password
# Адрес сервера, доступный с телефона (для ссылки верификации в письме)
BASE_URL=http://192.168.0.10:5000
