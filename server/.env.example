# Скопируйте в .env и заполните. Файл .env не коммитить.
PORT=5000
# Локально: mongodb://localhost:27017/happyhome
# MongoDB Atlas: mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/happyhome?retryWrites=true&w=majority
MONGO_URI=mongodb://localhost:27017/happyhome
JWT_SECRET=change_me_long_random_string
EMAIL_USER=your_email@gmail.com
# Gmail "пароль приложения" (App Password)
EMAIL_PASS=your_app_password
# Адрес сервера, доступный с телефона (для ссылки верификации в письме)
BASE_URL=http://192.168.0.10:5000

# Только для docker-compose.prod.yml (база на вашем сервере): учётная запись MongoDB.
# Пароль из букв и цифр, например: openssl rand -hex 16
MONGO_USER=happyhome
MONGO_PASSWORD=change_me_db_password
